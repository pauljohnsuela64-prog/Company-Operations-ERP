DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=erp_app
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_NAME=company_operations_erp

SECRET_KEY=YOUR_SECRET_KEY_HERE
# Use production only behind verified public HTTPS. Production enforces Secure
# session cookies, disables debug, and requires a strong SECRET_KEY (32+ bytes).
ERP_ENV=development
ERP_DEBUG=false
ERP_SESSION_IDLE_SECONDS=1800
ERP_SESSION_ABSOLUTE_SECONDS=28800
